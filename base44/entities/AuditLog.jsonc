{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "Action performed"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "old_data": {
      "type": "object"
    },
    "new_data": {
      "type": "object"
    },
    "ip_address": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "action"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "atendente"
          }
        },
        {
          "user_condition": {
            "role": "fiscal"
          }
        },
        {
          "user_condition": {
            "role": "equipe_campo"
          }
        },
        {
          "user_condition": {
            "role": "equipe"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
