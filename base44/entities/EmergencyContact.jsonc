{
  "name": "EmergencyContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name"
    },
    "number": {
      "type": "string",
      "description": "Phone number"
    },
    "type": {
      "type": "string",
      "description": "Contact type"
    },
    "description": {
      "type": "string",
      "description": "Public contact description"
    },
    "city": {
      "type": "string",
      "description": "City where the contact applies"
    },
    "state": {
      "type": "string",
      "description": "State where the contact applies"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this contact should be shown"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "atendente"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "atendente"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
